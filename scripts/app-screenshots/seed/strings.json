  "programme_text_notes.text": {
    "mock-ptn-1a": {
      "fr": "<p>Tissu satin rouge cerise, dos nu avec découpe en V.</p>",
      "en": "<p>Cherry red satin, open back with a V cut.</p>",
      "pcm": "<p>Cherry red satin cloth, open back with V cut.</p>",
      "hi": "<p>चेरी लाल साटन का कपड़ा, पीठ खुली और V कट।</p>",
      "ar": "<p>قماش ساتان أحمر كرزي، ظهر مكشوف بقصة على شكل V.</p>"
    },
    "mock-ptn-3a": {
      "fr": "<p>Grand boubou bazin riche blanc cassé, broderie argentée sur l'encolure.</p>",
      "en": "<p>Large off-white bazin riche boubou, silver embroidery on the neckline.</p>",
      "pcm": "<p>Big boubou, off-white bazin riche, silver embroidery for the neck.</p>",
      "hi": "<p>ऑफ़-व्हाइट बाज़ीन रिश का बड़ा बूबू, गले पर चाँदी की कढ़ाई।</p>",
      "ar": "<p>بوبو كبير من قماش البازان الريش بلون أبيض مكسور، وتطريز فضي عند فتحة الرقبة.</p>"
    },
    "mock-ptn-5a": {
      "fr": "<p>Dentelle ivoire, traine de 2m. Essayage prévu en semaine 12.</p>",
      "en": "<p>Ivory lace, 2 m train. Fitting planned for week 12.</p>",
      "pcm": "<p>Ivory lace, 2 m train. Fitting dey for week 12.</p>",
      "hi": "<p>आइवरी रंग की लेस, 2 मीटर की ट्रेन। फ़िटिंग सप्ताह 12 में तय है।</p>",
      "ar": "<p>دانتيل عاجي، ذيل بطول 2 متر. البروفة مقررة في الأسبوع 12.</p>"
    },
    "mock-ptn-6a": {
      "fr": "<p>Idée de modèle mixant wax et broderie traditionnelle.</p>",
      "en": "<p>Design idea mixing wax print and traditional embroidery.</p>",
      "pcm": "<p>Style idea wey mix wax and traditional embroidery.</p>",
      "hi": "<p>वैक्स प्रिंट और पारंपरिक कढ़ाई को मिलाने वाले डिज़ाइन का विचार।</p>",
      "ar": "<p>فكرة تصميم تجمع بين قماش الواكس والتطريز التقليدي.</p>"
    },
    "mock-ptn-9a": {
      "fr": "<p>Livré en retard suite manque de tissu. Remise de 5% accordée.</p>",
      "en": "<p>Delivered late because of a fabric shortage. 5% discount given.</p>",
      "pcm": "<p>Delivery late because cloth no dey. We give 5% discount.</p>",
      "hi": "<p>कपड़े की कमी के कारण देर से दिया गया। 5% की छूट दी गई।</p>",
      "ar": "<p>سُلِّم متأخرًا بسبب نقص القماش. تم منح خصم 5%.</p>"
    },
    "mock-ptn-10a": {
      "fr": "<p>Cliente n'a pas récupéré la commande. À relancer.</p>",
      "en": "<p>Customer did not collect the order. Follow up.</p>",
      "pcm": "<p>Customer no collect the order. Make we follow up.</p>",
      "hi": "<p>ग्राहक ने ऑर्डर नहीं लिया। दोबारा संपर्क करना है।</p>",
      "ar": "<p>لم تستلم الزبونة الطلب. يجب المتابعة معها.</p>"
    },
    "mock-ptn-12a": {
      "fr": "<p>Robe + veste coordonnée + headwrap assorti. Tissu wax premium.</p>",
      "en": "<p>Dress + matching jacket + matching headwrap. Premium wax fabric.</p>",
      "pcm": "<p>Dress + matching jacket + matching headwrap. Premium wax cloth.</p>",
      "hi": "<p>ड्रेस + मैचिंग जैकेट + मैचिंग हेडरैप। प्रीमियम वैक्स कपड़ा।</p>",
      "ar": "<p>فستان + جاكيت متناسق + غطاء رأس متناسق. قماش واكس فاخر.</p>"
    },
    "mock-ptn-12b": {
      "fr": "<p>Essayage 1 réalisé le 12/04. Quelques retouches sur les épaules.</p>",
      "en": "<p>Fitting 1 done on 12 April. A few alterations on the shoulders.</p>",
      "pcm": "<p>Fitting 1 don do for 12 April. Small adjustment for the shoulders.</p>",
      "hi": "<p>पहली फ़िटिंग 12 अप्रैल को हुई। कंधों पर कुछ सुधार बाकी हैं।</p>",
      "ar": "<p>تمت البروفة الأولى في 12 أبريل. بعض التعديلات على الكتفين.</p>"
    }
  },

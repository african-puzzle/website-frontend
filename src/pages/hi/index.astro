  <Hero lang={lang} />
  <ProofStrip lang={lang} />
  <AudioFirst lang={lang} />
  <Features lang={lang} />
  <Benefits lang={lang} />
  <Pricing lang={lang} />
  <CTA lang={lang} />
  <Reach lang={lang} />
  <Partners lang={lang} />

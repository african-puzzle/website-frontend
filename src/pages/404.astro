---
import Layout from '../layouts/Layout.astro';
import { t, defaultLocale } from '../i18n/utils';

const lang = defaultLocale;
---

<Layout title={t(lang, 'error.not_found')} lang={lang}>
  <section
    class="section-textured min-h-[78vh] flex items-center justify-center px-6 pt-24 pb-20 text-white"
    style="background-color: var(--theme-bg-hero); background-image: url('/images/background-hero.webp'); background-blend-mode: multiply;"
  >
    <div class="text-center max-w-xl">
      <p class="inline-flex px-4 py-1.5 rounded-full bg-brand-gold text-brand-ink-deep text-xs font-bold uppercase tracking-[.18em]">404</p>
      <h1 class="mt-6 text-4xl sm:text-5xl lg:text-6xl font-bold font-display">{t(lang, 'error.not_found')}</h1>
      <p class="mt-5 text-base sm:text-lg text-white/80 leading-relaxed">{t(lang, 'error.not_found_description')}</p>
      <a
        id="back-home"
        href="/fr/"
        class="mt-8 inline-block rounded-full bg-brand-gold px-7 py-3.5 text-sm font-bold text-brand-ink-deep shadow-lg hover:bg-brand-gold-soft transition-colors"
      >
        {t(lang, 'error.back_home')}
      </a>
    </div>
  </section>
</Layout>

<script>
  const locales = ['fr', 'en', 'pcm', 'hi', 'ar'];
  const defaultLocale = 'fr';

  const [, segment] = window.location.pathname.split('/');
  const locale = locales.includes(segment) ? segment : defaultLocale;
  const homePath = `/${locale}/`;

  // Update the back-home link to match detected locale
  const link = document.getElementById('back-home');
  if (link) link.setAttribute('href', homePath);

  // Redirect to the correct locale homepage
  const meta = document.createElement('meta');
  meta.httpEquiv = 'refresh';
  meta.content = `5;url=${homePath}`;
  document.head.appendChild(meta);
</script>

---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/sections/Hero.astro';
import ProofStrip from '../../components/sections/ProofStrip.astro';
import AudioFirst from '../../components/sections/AudioFirst.astro';
import Features from '../../components/sections/Features.astro';
import Benefits from '../../components/sections/Benefits.astro';
import Pricing from '../../components/sections/Pricing.astro';
import Reach from '../../components/sections/Reach.astro';
import Partners from '../../components/sections/Partners.astro';
import CTA from '../../components/sections/CTA.astro';
import DownloadBanner from '../../components/sections/DownloadBanner.astro';

const lang = 'en';
---

<Layout
  title="Home"
  description="African Puzzle WORKS — the app that organizes daily life for artisans, tailors, creatives and entrepreneurs: clients, measurements, appointments and payments."
  lang={lang}
>
  <Hero lang={lang} />
  <ProofStrip lang={lang} />
  <AudioFirst lang={lang} />
  <Features lang={lang} />
  <Benefits lang={lang} />
  <Pricing lang={lang} />
  <CTA lang={lang} />
  <Reach lang={lang} />
  <Partners lang={lang} />
  <DownloadBanner lang={lang} />
</Layout>

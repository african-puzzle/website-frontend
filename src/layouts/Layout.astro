---
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import VideoModal from '../components/ui/VideoModal.astro';
import type { Locale } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  lang: Locale;
  schemaType?: string; // WebPage-family type, e.g. AboutPage, ContactPage
}

// Per-locale fallback so no page ships an empty meta description
const DEFAULT_DESCRIPTIONS: Record<Locale, string> = {
  fr: "African Puzzle : l'application mobile de puzzles qui célèbre l'art et la culture africaine. Découvrez des œuvres d'artistes africains en jouant.",
  en: 'African Puzzle: the mobile puzzle app celebrating African art and culture. Discover works by African artists while you play.',
  pcm: 'African Puzzle: mobile puzzle app wey dey celebrate African art and culture. Play and discover work from African artists.',
};

const { title, description: descriptionProp, lang, schemaType = 'WebPage' } = Astro.props;
const description = descriptionProp || DEFAULT_DESCRIPTIONS[lang];
const fullTitle = `${title} | African Puzzle`;

const SITE = 'https://africanpuzzle.com';
const canonical = `${SITE}${Astro.url.pathname}`;
// Locale-prefixed pages get hreflang alternates; assumes parallel paths per locale
const LOCALES: Locale[] = ['fr', 'en', 'pcm'];
const pathMatch = Astro.url.pathname.match(/^\/(fr|en|pcm)(\/.*)?$/);
// FR uses translated slugs; map shared pages across locales
const SLUG_MAP: Record<string, Record<string, string>> = {
  fr: { '/a-propos/': '/about/', '/confidentialite/': '/privacy/', '/medias/': '/media/' },
};
function localePath(target: Locale): string | null {
  if (!pathMatch) return null;
  const [, cur, rest = '/'] = pathMatch;
  let slug = rest;
  if (cur === 'fr' && target !== 'fr') slug = SLUG_MAP.fr[rest] ?? rest;
  if (cur !== 'fr' && target === 'fr') {
    const inv = Object.entries(SLUG_MAP.fr).find(([, v]) => v === rest);
    slug = inv ? inv[0] : rest;
  }
  return `${SITE}/${target}${slug}`;
}

const OG_LOCALES: Record<Locale, string> = { fr: 'fr_FR', en: 'en_US', pcm: 'pcm_NG' };
const ogLocale = OG_LOCALES[lang];
const ogAlternates = LOCALES.filter((l) => l !== lang).map((l) => OG_LOCALES[l]);

// JSON-LD for AI/agent + search visibility
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#organization`,
      name: 'African Puzzle',
      url: SITE,
      logo: `${SITE}/images/og-image.png`,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      name: 'African Puzzle',
      url: SITE,
      inLanguage: lang,
      publisher: { '@id': `${SITE}/#organization` },
    },
    {
      '@type': schemaType,
      name: fullTitle,
      description,
      inLanguage: lang,
      url: canonical,
      isPartOf: { '@id': `${SITE}/#website` },
    },
  ],
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <!-- Anti-FOWT: apply theme before first paint -->
    <script is:inline>
      (function() {
        var s = localStorage.getItem('theme');
        var d = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (s === 'dark' || (s !== 'light' && d)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <link rel="canonical" href={canonical} />
    {pathMatch && LOCALES.map((l) => <link rel="alternate" hreflang={l} href={localePath(l)} />)}
    {pathMatch && <link rel="alternate" hreflang="x-default" href={localePath('fr')} />}

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="African Puzzle" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE}/images/og-image.png`} />
    <meta property="og:locale" content={ogLocale} />
    {ogAlternates.map((l) => <meta property="og:locale:alternate" content={l} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/images/og-image.png`} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Fonts: self-hosted (see global.css @font-face) -->
    <link rel="preload" href="/fonts/montserrat-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/nunito-latin-700.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <Navbar lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <VideoModal />
  </body>
</html>

---
import type { Locale } from '../../i18n/utils';
import { appScreen, type AppScreen } from '../../lib/appScreens';

interface Props {
  lang: Locale;
  name: AppScreen;
  alt: string;
  eager?: boolean;
  class?: string;
  style?: string;
}

const { lang, name, alt, eager = false, class: className = '', style } = Astro.props;
const { light, dark } = appScreen(lang, name);
---

<!-- The `dark` class on <html> picks the image (see global.css); the hidden one is display:none, so a lazy image is not fetched. -->
<img src={light} alt={alt} class:list={['screen-light', 'app-shot', className]} style={style} width="720" height="1565" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
<img src={dark} alt={alt} class:list={['screen-dark', 'app-shot', className]} style={style} width="720" height="1565" loading="lazy" decoding="async" />

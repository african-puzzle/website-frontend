---
interface Props {
  src: string;
  alt: string;
  class?: string;
  eager?: boolean;
}

const { src, alt, class: className = '', eager = false } = Astro.props;
---

<div class:list={['phone-frame', className]}>
  <img
    src={src}
    alt={alt}
    class="phone-screen"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    width="409"
    height="855"
  />
  <img src="/images/phone-frame.svg" alt="" class="phone-bezel" aria-hidden="true" width="409" height="855" />
</div>

<style>
  .phone-frame {
    position: relative;
    width: var(--phone-width, 220px);
    aspect-ratio: 409 / 855;
    background: #000;
    border-radius: 2.5rem;
  }

  .phone-screen {
    position: absolute;
    top: 5.5%;
    left: 5.5%;
    width: 90%;
    height: 88%;
    object-fit: cover;
    border-radius: 2rem;
  }

  .phone-bezel {
    position: relative;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }
</style>

---
interface Props {
  src: string;
  alt: string;
  class?: string;
  eager?: boolean;
}

const { src, alt, class: className = '', eager = false } = Astro.props;
---

<div class:list={['phone-frame', className]}>
  <img
    src={src}
    alt={alt}
    class="phone-screen"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    width="720"
    height="1565"
  />
</div>

<style>
  .phone-frame {
    width: var(--phone-width, 220px);
    aspect-ratio: 720 / 1565;
    padding: clamp(5px, 1.8%, 8px);
    background: #09080c;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: clamp(1.6rem, 11%, 2.4rem);
    box-shadow:
      0 2px 0 rgba(255, 255, 255, 0.14) inset,
      0 28px 56px rgba(20, 12, 34, 0.32);
  }

  .phone-screen {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: clamp(1.25rem, 9.5%, 2rem);
  }
</style>

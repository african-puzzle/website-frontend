---
import type { Locale } from '../../i18n/utils';
import type { AppScreen } from '../../lib/appScreens';
import AppScreenImg from './AppScreenImg.astro';

interface Props {
  lang?: Locale; // lang + name render the screen; omit both when passing slides via the default slot
  name?: AppScreen;
  alt?: string;
  class?: string;
  eager?: boolean;
}

const { lang, name, alt = '', class: className = '', eager = false } = Astro.props;
---

<div class:list={['phone-frame', className]}>
  {Astro.slots.has('default') ? (
    <div class="phone-screen" style="position: relative; overflow: hidden;"><slot /></div>
  ) : (
    <AppScreenImg lang={lang!} name={name!} alt={alt} eager={eager} />
  )}
</div>

<style>
  .phone-frame {
    width: var(--phone-width, 220px);
    aspect-ratio: 720 / 1565;
    padding: clamp(5px, 1.8%, 8px);
    background: #09080c;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: clamp(1.6rem, 11%, 2.4rem);
    box-shadow:
      0 2px 0 rgba(255, 255, 255, 0.14) inset,
      0 28px 56px rgba(20, 12, 34, 0.32);
  }

  .phone-screen {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: clamp(1.25rem, 9.5%, 2rem);
  }
</style>

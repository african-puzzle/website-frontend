---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  compact?: boolean;
}

const { eyebrow, title, subtitle = '', compact = false } = Astro.props;
---

<section
  class:list={[
    'section-textured overflow-hidden pt-16 text-white',
    compact ? 'pb-20 lg:pb-24' : 'pb-24 lg:pb-32',
  ]}
  style="background-color: var(--theme-bg-hero); background-image: url('/images/background-hero.webp'); background-blend-mode: multiply;"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 lg:pt-20">
    <div class="max-w-4xl">
      <p class="inline-flex items-center px-4 py-1.5 rounded-full bg-brand-gold text-brand-ink-deep text-xs font-bold uppercase tracking-wider">
        {eyebrow}
      </p>
      <h1 class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-bold font-display leading-tight">
        {title}
      </h1>
      {subtitle && (
        <p class="mt-5 text-lg sm:text-xl text-white/85 leading-relaxed max-w-2xl">
          {subtitle}
        </p>
      )}
    </div>
  </div>
</section>

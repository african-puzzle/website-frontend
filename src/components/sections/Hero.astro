---
import { t, type Locale } from '../../i18n/utils';
import site from '../../content/settings/site.json';
import PhoneFrame from '../ui/PhoneFrame.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const contactPath = `/${lang}/contact/`;
const dir = lang === 'fr' ? '/images/app' : `/images/app/${lang}`;

// Placeholder slides, one per profession; swap in the CEO's screens later.
// The keyframes below assume 5 slides; update their percentages if the count changes.
const slides = [
  `${dir}/programmes-tab.webp`, // dressmaking
  `${dir}/contacts-tab.webp`, // hairdressing
  `${dir}/albums-tab.webp`, // car mechanic
  `${dir}/rendez-vous-tab.webp`, // building work
  `${dir}/measurements.webp`, // mixed (covers from other fields)
];
const SLIDE_SECONDS = 4.5;
---

<section
  class="section-textured relative flex items-center overflow-hidden pt-16"
  style="background-color: var(--theme-bg-hero); background-image: url('/images/background-hero.webp'); background-blend-mode: multiply;"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-16 lg:py-24 flex flex-col lg:flex-row items-center gap-10 lg:gap-16">
    <!-- Left: message + actions -->
    <div class="lg:w-3/5">
      {!site.launched && (
        <p class="inline-block px-4 py-1.5 rounded-full bg-brand-gold text-brand-ink-deep text-sm font-bold">
          {t(lang, 'hero.launch_badge')}
        </p>
      )}
      <h1 class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-bold font-display text-white leading-tight">
        {t(lang, 'hero.title')}
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-white/90 max-w-xl leading-relaxed">
        {t(lang, 'hero.subtitle')}
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4">
        <a
          href="#proof"
          class="inline-flex items-center justify-center px-8 py-4 bg-brand-gold text-brand-ink-deep font-bold rounded-full shadow-lg hover:bg-brand-gold-soft hover:shadow-xl transition-all duration-300 hover:-translate-y-0.5"
        >
          {t(lang, 'hero.cta_how')}
        </a>
        {site.launched ? (
          <div class="flex flex-col sm:flex-row items-center gap-3">
            <span aria-hidden="true" class="text-white font-semibold">{t(lang, 'hero.cta_download')}</span>
            <a href={site.playStoreUrl} target="_blank" rel="noopener noreferrer">
              <img src="/images/google-play-badge.svg" alt={t(lang, 'download.play_badge_live_alt')} width="135" height="40" class="h-14 w-auto" />
            </a>
          </div>
        ) : (
          <a
            href={contactPath}
            class="inline-flex items-center justify-center px-8 py-4 border-2 border-white/40 text-white font-semibold rounded-full hover:border-white/80 hover:bg-white/10 transition-all duration-300"
          >
            {t(lang, 'hero.cta_notify')}
          </a>
        )}
      </div>
    </div>

    <!-- Right: real app screen in device frame -->
    <div class="lg:w-2/5 flex justify-center">
      <div style="--phone-width: min(260px, 62vw); filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.35));">
        <PhoneFrame>
          <div class="slides" style={`--n: ${slides.length}; --dur: ${SLIDE_SECONDS}s;`}>
            {slides.map((src, i) => (
              <img
                src={src}
                alt={i === 0 ? t(lang, 'features.programmes_title') : ''}
                aria-hidden={i === 0 ? undefined : 'true'}
                class:list={['slide', { 'slide-first': i === 0 }]}
                style={`--i: ${i};`}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'low'}
                decoding="async"
                width="720"
                height="1565"
              />
            ))}
          </div>
        </PhoneFrame>
      </div>
    </div>
  </div>
</section>

<style>
  .slides {
    position: absolute;
    inset: 0;
  }
  .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }
  .slide-first {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .slide {
      animation: slide-fade calc(var(--n) * var(--dur)) infinite;
      animation-delay: calc(var(--i) * var(--dur));
    }
    .slide-first {
      animation-name: slide-fade-first;
      animation-delay: 0s;
    }
    .slides:hover .slide {
      animation-play-state: paused;
    }
  }
  /* 5 slides: each visible 20% of the cycle, 4% crossfade overlap */
  @keyframes slide-fade {
    0% { opacity: 0; }
    4%, 20% { opacity: 1; }
    24%, 100% { opacity: 0; }
  }
  @keyframes slide-fade-first {
    0%, 20% { opacity: 1; }
    24%, 96% { opacity: 0; }
    100% { opacity: 1; }
  }
</style>

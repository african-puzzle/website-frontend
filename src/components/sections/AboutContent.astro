---
import { t, type Locale } from '../../i18n/utils';
import { getCollection } from 'astro:content';
import aboutPage from '../../content/settings/about-page.json';
import PhoneFrame from '../ui/PhoneFrame.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const teamEntries = await getCollection('team');
const team = teamEntries
  .sort((a, b) => a.data.order - b.data.order)
  .map(entry => entry.data);
---

<section class="pb-20 lg:pb-28" style="background-color: var(--theme-bg-about);">
  <!-- Full-bleed hero -->
  <div class="relative w-full h-[60vh] md:h-[80vh] lg:h-screen overflow-hidden">
    <img
      src={aboutPage.heroImage}
      alt="African Puzzle"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 flex items-center">
      {/* Logo stays on the left of the photo in Arabic too (the subject sits on the right). */}
      <div class="max-w-7xl mx-auto w-full px-6 sm:px-10 lg:px-16" dir={lang === 'ar' ? 'ltr' : undefined}>
        <img
          src="/images/logo-white-full.svg"
          alt="African Puzzle — Find Africa everywhere"
          class="w-40 sm:w-56 md:w-72 lg:w-[360px] drop-shadow-lg"
        />
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16">

    <!-- Purple Banner with Phone -->
    <div
      class="section-textured before:rounded-2xl bg-brand-purple-600 rounded-2xl overflow-visible relative mb-24 lg:mb-32"
      style="background-image: url('/images/features-texture.svg');"
    >
      <div class="flex flex-col lg:flex-row items-center">
        <!-- Text side -->
        <div class="flex-1 px-6 py-4 lg:py-5 lg:px-12 text-white">
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold font-display uppercase leading-tight mb-4 whitespace-nowrap">
            {t(lang, 'about.title')}
          </h1>
          <p class="text-lg leading-relaxed opacity-90 mb-4">
            {t(lang, 'about.innovation')}
          </p>
          <p class="text-lg leading-relaxed" set:html={t(lang, 'about.creative_statement')} />
        </div>

        <!-- Phone mockup — protrudes above and below -->
        <div class="relative flex-shrink-0 px-8 lg:px-12 my-4 lg:my-0">
          <div class="lg:my-[-4rem]">
            <div style="--phone-width: min(18rem, 64vw);">
              <PhoneFrame lang={lang} name="programmes-tab" alt="African Puzzle WORKS app" />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Team -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <p class="text-xs font-bold uppercase tracking-[.16em] text-brand-purple-600 dark:text-brand-purple-300">
        {t(lang, 'about.label')}
      </p>
      <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-bold font-display" style="color: var(--theme-text-about-name);">
        {t(lang, 'about.team_title')}
      </h2>
      <p class="mt-4 text-base leading-relaxed" style="color: var(--theme-text-primary);">
        {t(lang, 'about.mission')}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {team.map((member) => (
        <div class="text-center group rounded-2xl border p-5 lg:p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl" style="background-color: var(--theme-bg-card); border-color: var(--theme-border-navbar);">
          <div class="relative w-40 h-40 lg:w-48 lg:h-48 mx-auto mb-5 rounded-full flex items-center justify-center text-3xl lg:text-5xl font-bold overflow-hidden shadow-lg group-hover:shadow-xl transition-shadow duration-300" style="background-color: var(--theme-bg-about); color: var(--theme-text-about-name);">
            <span>{member.name.split(' ').map(n => n[0]).join('')}</span>
            {/* eslint-disable astro/jsx-a11y/no-noninteractive-element-interactions -- onerror hides a broken photo so the initials show */}
            {member.photo && (
              <img
                src={member.photo}
                alt={member.name}
                class="absolute inset-0 w-full h-full object-cover"
                onerror="this.style.display='none'"
              />
            )}
            {/* eslint-enable astro/jsx-a11y/no-noninteractive-element-interactions */}
          </div>
          <h3 class="font-bold text-lg" style="color: var(--theme-text-about-name);">
            {member.name}
          </h3>
          {member.role[lang] && (
            <p class="text-base mt-1" style="color: var(--theme-text-about-role);">
              {member.role[lang]}
            </p>
          )}
          {member.linkedin && (
            <a
              href={member.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 mt-3 text-base transition-colors hover:opacity-70"
              style="color: var(--theme-text-about-name);"
            >
              LinkedIn
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

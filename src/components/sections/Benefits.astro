---
import { t, type Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const benefits = [
  { title: t(lang, 'benefits.efficient_title'), desc: t(lang, 'benefits.efficient_desc') },
  { title: t(lang, 'benefits.time_title'), desc: t(lang, 'benefits.time_desc') },
  { title: t(lang, 'benefits.happy_title'), desc: t(lang, 'benefits.happy_desc') },
];
---

<section
  class="section-textured py-24 lg:py-32"
  style="background-color: var(--theme-bg-benefits); background-image: url('/images/speckled-block.png');"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-14 sm:gap-16">
      {benefits.map((b) => (
        <div class="text-center">
          <h3 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white font-display">
            {b.title}
          </h3>
          <p class="mt-3 text-lg sm:text-xl text-brand-purple-100 leading-relaxed max-w-2xl mx-auto">
            {b.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

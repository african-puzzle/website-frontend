---
import { t, type Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const proofPoints = [
  { title: t(lang, 'proof.audio_title'), body: t(lang, 'proof.audio_body') },
  { title: t(lang, 'proof.pricing_title'), body: t(lang, 'proof.pricing_body') },
  { title: t(lang, 'proof.audience_title'), body: t(lang, 'proof.audience_body') },
];
---

<section class="border-b" style="background-color: var(--theme-bg-primary); border-color: var(--theme-border-navbar);">
  <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-3 px-4 sm:px-6 lg:px-8">
    {proofPoints.map((point, index) => (
      <div
        class:list={[
          'py-7 sm:py-8 sm:px-6 lg:px-10 text-center sm:text-left',
          index > 0 && 'border-t sm:border-t-0 sm:border-l',
        ]}
        style="border-color: var(--theme-border-navbar);"
      >
        <h2 class="text-xl lg:text-2xl font-bold font-display" style="color: var(--theme-text-heading);">
          {point.title}
          {index === 2 && (
            <svg class="inline-block align-[-0.1em] ml-1.5 w-[1em] h-[1em]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M11 5 6 9H2v6h4l5 4V5z" />
              <path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" />
            </svg>
          )}
        </h2>
        <p class="mt-1.5 text-sm leading-relaxed" style="color: var(--theme-text-primary);">
          {point.body}
        </p>
      </div>
    ))}
  </div>
</section>

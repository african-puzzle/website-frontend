---
import { t, type Locale, type TranslationKey } from '../../i18n/utils';
import { getCollection } from 'astro:content';
import PhoneFrame from '../ui/PhoneFrame.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

// The six bundled screenshots have a copy per locale in /images/app/<lang>/ (fr is the default folder).
const bundledScreens = new Set(['programmes-tab', 'contacts-tab', 'measurements', 'albums-tab', 'rendez-vous-tab', 'collaborators']);
const localScreen = (screen: string) => {
  const name = screen.match(/^\/images\/app\/([^/]+)\.webp$/)?.[1];
  return lang !== 'fr' && name && bundledScreens.has(name) ? `/images/app/${lang}/${name}.webp` : screen;
};

const featureEntries = await getCollection('features');
const features = featureEntries
  .sort((a, b) => a.data.order - b.data.order)
  .map(entry => ({
    title: t(lang, entry.data.titleKey as TranslationKey),
    desc: t(lang, entry.data.descKey as TranslationKey),
    screen: lang === 'en'
      ? (entry.data.screenEn ?? localScreen(entry.data.screen))
      : localScreen(entry.data.screen),
    cardBg: entry.data.cardBg,
  }));
---

<section
  id="fonctionnalites"
  class="section-textured py-20 lg:py-28 overflow-hidden"
  style="background-color: var(--theme-bg-features); background-image: url('/images/features-texture.svg');"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-4xl sm:text-5xl font-bold font-display text-white">
        {t(lang, 'features.title')}
      </h2>
      <p class="mt-4 text-lg text-white/85">
        {t(lang, 'features.subtitle')}
      </p>
    </div>

    <!-- Feature cards with phone mockups -->
    <div class="space-y-20 lg:space-y-36 lg:py-14 max-w-5xl mx-auto">
      {features.map((feature, index) => (
        <div class={`${feature.cardBg} dark:brightness-[.92] rounded-2xl relative overflow-visible reveal`}>
          <div class={`grid grid-cols-1 ${index % 2 === 1 ? 'lg:grid-cols-[auto_1fr]' : 'lg:grid-cols-[1fr_auto]'} items-center gap-4 lg:gap-8`}>
            <!-- Text side -->
            <div class={`px-6 py-8 lg:py-10 lg:px-12 ${index % 2 === 1 ? 'lg:order-2' : ''}`}>
              <h3 class="text-3xl lg:text-5xl font-bold font-display text-slate-900 mb-3">
                {feature.title}
              </h3>
              <p class="text-xl lg:text-2xl text-slate-800 leading-relaxed max-w-md">
                {feature.desc}
              </p>
            </div>

            <!-- Phone mockup side -->
            <div class={`relative flex justify-center px-8 pb-8 lg:px-12 lg:py-0 lg:my-[-4.5rem] ${index % 2 === 1 ? 'lg:order-1' : ''}`}>
              <div class="phone-pop" style="--phone-width: min(250px, 58vw);">
                <PhoneFrame src={feature.screen} alt={feature.title} />
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .phone-pop {
    filter: drop-shadow(0 16px 32px rgba(0, 0, 0, 0.25));
  }
</style>

<script>
  // Scroll reveal: arm only when JS runs; content is visible by default.
  const els = document.querySelectorAll('.reveal');
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('reveal-in');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px' }
    );
    for (const el of els) {
      el.classList.add('reveal-armed');
      io.observe(el);
    }
    // Safety: never leave content hidden if IO stalls (headless renderers, prerender)
    setTimeout(() => els.forEach((el) => el.classList.add('reveal-in')), 2500);
    // Anchor jumps (e.g. nav "Fonctionnalités") should not catch cards mid-fade
    document.addEventListener('click', (ev) => {
      const a = (ev.target as Element).closest?.('a[href*="#"]');
      if (a) els.forEach((el) => el.classList.add('reveal-in'));
    });
  }
</script>

---
import { t, type Locale } from '../../i18n/utils';
import { getCollection } from 'astro:content';
import { iconPath } from '../../lib/social-icons';
import DownloadBanner from './DownloadBanner.astro';
import InstagramFeed from './InstagramFeed.astro';
import PageHero from '../ui/PageHero.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const methods = (await getCollection('contact')).map((m) => m.data).sort((a, b) => a.order - b.order);
// Cards: entries flagged for the contact page that have a link and a known icon.
const channels = methods
  .filter((m) => m.showInContact && m.url && iconPath(m.icon))
  .map((m) => ({ name: m.label, value: m.value, href: m.url, icon: iconPath(m.icon) }));
const email = methods.find((m) => m.icon === 'email')?.value ?? '';
---

<PageHero
  eyebrow={t(lang, 'contact.label')}
  title={t(lang, 'contact.title')}
  subtitle={t(lang, 'contact.subtitle')}
/>

<section class="relative py-16 lg:py-24" style="background-color: var(--theme-bg-primary);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-6">
          {channels.map((channel) => (
            <a
              href={channel.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group rounded-2xl border p-6 transition hover:-translate-y-1 hover:shadow-lg"
              style="background-color: var(--theme-bg-card); border-color: var(--theme-border-navbar);"
            >
              <span class="w-11 h-11 rounded-full bg-brand-purple-100 dark:bg-brand-purple-900/30 flex items-center justify-center">
                <svg class="w-5 h-5" fill="var(--theme-icon-contact)" viewBox="0 0 24 24" aria-hidden="true">
                  <path d={channel.icon} />
                </svg>
              </span>
              <h2 class="font-bold text-lg mt-5" style="color: var(--theme-text-contact);">{channel.name}</h2>
              <p class="mt-1 text-sm underline group-hover:no-underline" style="color: var(--theme-text-primary);"><bdi>{channel.value}</bdi></p>
            </a>
          ))}

          <div class="rounded-2xl border p-6 sm:col-span-2 lg:col-span-1" style="background-color: var(--theme-bg-card); border-color: var(--theme-border-navbar);">
            <span class="w-11 h-11 rounded-full bg-brand-purple-100 dark:bg-brand-purple-900/30 flex items-center justify-center">
              <svg class="w-5 h-5" fill="var(--theme-icon-contact)" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2a7 7 0 00-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 00-7-7Zm0 9.5A2.5 2.5 0 1112 6a2.5 2.5 0 010 5.5Z"/>
              </svg>
            </span>
            <h2 class="font-bold text-lg mt-5" style="color: var(--theme-text-contact);"><bdi>{t(lang, 'contact.address_company')}</bdi></h2>
            <p class="mt-1 text-sm leading-relaxed" style="color: var(--theme-text-primary);">
              <bdi>{t(lang, 'contact.address_street')}</bdi><br /><bdi>{t(lang, 'contact.address_city')}</bdi>
            </p>
            <a href={`mailto:${email}`} class="inline-block mt-3 text-sm font-semibold underline hover:no-underline" style="color: var(--theme-text-contact);">
              <bdi>{email}</bdi>
            </a>
          </div>
    </div>
  </div>
</section>

<!-- Instagram Feed -->
<InstagramFeed lang={lang} />

<!-- Download CTA -->
<DownloadBanner lang={lang} />
